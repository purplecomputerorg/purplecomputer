[Unit]
Description=Purple Computer live kernel log to the USB stick
# Live boots only, like purple-diag-dump: the stick is where the file lives.
ConditionPathIsMountPoint=/cdrom
ConditionKernelCommandLine=!purple.install=1
DefaultDependencies=no
After=systemd-udev-trigger.service

[Service]
Type=simple
ExecStart=/usr/local/bin/purple-kmsg-stream
Nice=10
Restart=on-failure
RestartSec=5

[Install]
WantedBy=sysinit.target
