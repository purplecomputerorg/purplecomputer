[Unit]
Description=Purple Computer: packs from a USB drive (%i)
After=local-fs.target
# A drive present at boot is read before Purple starts, so its packs are
# offered on the first screen; one plugged in later is offered within seconds.
Before=purple-x11.service

[Service]
Type=oneshot
# A drive that won't mount or read must not hold Purple's start for long.
TimeoutStartSec=60

# Mount the drive read-only with nothing on it runnable, set any packs aside
# in the purple user's ~/.purple/packs-waiting for the app to offer,
# unmount. A drive with no packs on it never starts Python.
ExecStartPre=/bin/mkdir -p /run/purple-update/%i
ExecStartPre=/bin/mount -o ro,nosuid,nodev,noexec /dev/%i /run/purple-update/%i
ExecStart=/bin/sh -c 'ls /run/purple-update/%i/*.purplepack >/dev/null 2>&1 || exit 0; exec /usr/bin/python3 -m purple_tui.usb_updater /run/purple-update/%i'
ExecStopPost=-/bin/umount /run/purple-update/%i
ExecStopPost=-/bin/rmdir /run/purple-update/%i

# Root: the mount, plus chowning the installed packs to the purple user.
User=root
Environment=PYTHONPATH=/opt/purple
