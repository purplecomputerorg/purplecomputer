#!/bin/bash
# Purple Computer X11 Startup
# Simple and reliable - no edge cases

# Log for debugging (view with: cat /tmp/xinitrc.log)
exec >> /tmp/xinitrc.log 2>&1

DEBUG_FLAG=/opt/purple/debug
BOOT_LOG_TMP=/tmp/purple-boot.log
BOOT_LOG_PERSIST=/var/log/purple/boot.log

# Ensure persistent log dir exists. /var/log is tmpfs on standard ISO and the
# casper "writable" ext4 partition on the debug ISO. This mkdir is a no-op on
# the former, which is fine -- the tmpfs write still works for the current boot.
mkdir -p /var/log/purple 2>/dev/null || true

# Boot log rotation is done by purple-wait-display.sh (ExecStartPre of
# purple-x11.service), NOT here. xinitrc re-execs itself after every normal
# Purple restart (see exec "$0" at the bottom of this file), so rotating
# here would lose the original-boot log on the second Purple restart. We
# want boot.log.prev to mean "the previous boot" not "the previous Purple
# launch within the same boot."

xlog() {
    local msg="[$(date '+%H:%M:%S.%3N')] [xinitrc] $1"
    echo "$msg"
    echo "$msg" >> "$BOOT_LOG_TMP" 2>/dev/null || true
    echo "$msg" >> "$BOOT_LOG_PERSIST" 2>/dev/null || true
    logger -t purple-boot -- "$msg" 2>/dev/null || true
}

xlog "=== xinitrc started ===  debug_flag=$([ -f "$DEBUG_FLAG" ] && echo yes || echo no)"

# keyd diagnostics: recorded on every boot so that when someone reports
# "Ctrl+Alt+RightAlt doesn't reach tty2" we can tell from the log whether
# the problem is keyd not running, not installed, wrong config, or
# Purple's side. None of these commands need root.
if [ -f /etc/keyd/default.conf ]; then
    xlog "keyd config present ($(wc -l < /etc/keyd/default.conf 2>/dev/null || echo ?) lines)"
else
    xlog "keyd config MISSING at /etc/keyd/default.conf"
fi
if command -v keyd >/dev/null 2>&1; then
    xlog "keyd binary: $(keyd -v 2>&1 | head -1)"
else
    xlog "keyd binary MISSING from PATH"
fi
keyd_pid=$(pgrep -x keyd || true)
if [ -n "$keyd_pid" ]; then
    xlog "keyd process running (pid=$keyd_pid)"
else
    xlog "keyd process NOT running"
fi
# List evdev devices so we can see whether the virtual keyboard exists yet.
# $(< file) and ${dev##*/} are bash builtins -- no fork per iteration.
for dev in /dev/input/event*; do
    [ -e "$dev" ] || continue
    name=$(< "/sys/class/input/${dev##*/}/device/name") 2>/dev/null || name="?"
    xlog "  evdev: $dev ($name)"
done

# xinit guarantees X is ready before running this script (SIGUSR1 handshake +
# XOpenDisplay polling). No sleep needed. See guides/boot-display-sequence.md.
xlog "X server ready (xinit handshake)"

# Hide the mouse cursor permanently (keyboard-only UI, no mouse needed).
# unclutter -idle 0 hides immediately; -root avoids event interference.
# Previous approaches that didn't work:
#   xsetroot -cursor: only hides on root window, not inside the app window
#   XFixesHideCursor one-shot: cursor hide dies when the script exits
unclutter -idle 0 -root &
xlog "unclutter started (PID=$!)"

# Clear the underlying VT text buffer. X.Org writes startup messages (version
# info, keymap warnings) to tty1 before switching to graphics mode. Those stay
# in the VT buffer and reappear when X exits (e.g. during shutdown). Clearing
# now while X covers the screen means there's nothing scary underneath.
printf '\033]P02d1b4e\033[H\033[2J\033[?25l' > /dev/tty1 2>/dev/null

# Start PulseAudio (may not auto-start in live boot)
pulseaudio --start --exit-idle-time=-1 2>/dev/null || true

# Disable screen blanking
xset s off -dpms s noblank b off

# Kid-proofing: disable XKB accessibility features
# Sticky keys can be triggered by holding Shift for 5 seconds
# Slow keys can be triggered by holding Shift for 8 seconds
# These would confuse kids and make typing unpredictable
if command -v xkbset &>/dev/null; then
    xkbset -a  # Disable all AccessX features
fi

# Keyboard repeat (faster for kids)
xset r rate 300 30

# SPICE agent for VM resize (harmless on real hardware)
command -v spice-vdagent &>/dev/null && spice-vdagent &

# Set root window background color
xsetroot -solid "#2d1b4e"

# The squashfs warm-up and RAM lock that make the stick safe to pull run as
# root in purple-usb-cache.service, at idle disk priority.

# Window manager (required for fullscreen)
matchbox-window-manager -use_titlebar no &
sleep 0.5
xlog "matchbox-window-manager started"

# Tear-free compositor. The modesetting driver has no TearFree option, so this
# is what stops old Intel panels flashing a checkerboard of the old+new frame
# during transitions. Guarded launcher: never blocks or fails the session.
# Backgrounded, and held until the TUI has painted its first frame (Purple
# touches UI_READY_MARKER then). picom's GL-context init is its slowest step,
# and on the oldest Intel target (the only machine slow enough to notice) it
# otherwise contends with the Python/Textual/pygame import + first-paint crunch
# and stretches time-to-interactive. The compositor only protects user-driven
# transitions, which can't happen that early, so waiting costs nothing. The
# marker beats a fixed sleep: it tracks the actual end of the crunch on any
# hardware. Bounded wait with a fallback so a missing marker never strands us
# uncomposited. picom attaches to existing windows, so coming up late is fine.
# See guides/intel-display-tuning.md.
UI_READY_MARKER=/tmp/purple-ui-ready
(
    for _ in $(seq 1 60); do
        [ -f "$UI_READY_MARKER" ] && break
        sleep 0.25
    done
    # Sizes the live session's RAM floor (LIVE_MIN_KB in the 32-bit Key's boot script).
    xlog "memory at UI ready: $(awk '/^(MemTotal|MemAvailable):/ {printf "%s %dMB  ", $1, $2 / 1024}' /proc/meminfo)"
    xlog "compositor: $(purple-start-compositor 2>&1)"
) &

# Debug mode: extra display diagnostics at boot
if [ -f "$DEBUG_FLAG" ]; then
    xlog "--- Display diagnostics (debug mode) ---"
    echo "xrandr:"
    xrandr 2>&1 | head -20
    xlog "--- End display diagnostics ---"
fi

# Purple draws straight into an SDL window with software rendering: no GL,
# no terminal emulator, no font sizing. LIBGL_ALWAYS_SOFTWARE stays set so
# nothing in the session touches a GPU driver that may lie (see
# guides/intel-display-tuning.md); picom picks its own backend.
export LIBGL_ALWAYS_SOFTWARE=1
export SDL_VIDEODRIVER=x11

xlog "Launching Purple..."
/usr/local/bin/purple
PURPLE_EXIT=$?
xlog "Purple exited with code $PURPLE_EXIT"

# Restart Purple (keeps X running for fast restart without screen flash).
# If X itself crashes, this script exits and systemd restarts the whole service.
xlog "Restarting xinitrc"
exec "$0"
